rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Receipts: user-scoped, auth-required, JPEG/PNG only, max 10MB
    match /receipts/{userId}/{transactionId}/{fileName} {
      // Allow read if logged in (for lightbox viewing)
      allow read: if request.auth != null;
      
      // Allow write only to own folder, with file type and size restrictions
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.contentType.matches('image/(jpeg|png)')
                   && request.resource.size < 10 * 1024 * 1024; // 10MB max
      
      // Allow delete only to own folder
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
